<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CIPAdmin.Backend</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- A previous publish run into Backend/publish/ (and any nested publish/bin/obj)
       would otherwise be picked up by the Web SDK's default Content glob and shipped
       INSIDE the new output as backend\publish\appsettings.json - a duplicate config
       that silently overrides nothing but confuses every deploy. Exclude them. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Stored Procedures\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tesseract language data (eng.traineddata) must ship next to the binaries. -->
  <ItemGroup>
    <Content Include="tessdata\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
